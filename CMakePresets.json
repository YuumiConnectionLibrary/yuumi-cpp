{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "YUUMI_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows-msvc-debug",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": {"value": "x64"},
      "cacheVariables": {"CMAKE_CONFIGURATION_TYPES": "Debug"}
    },
    {
      "name": "windows-msvc-release",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": {"value": "x64"},
      "cacheVariables": {"CMAKE_CONFIGURATION_TYPES": "Release"}
    },
    {
      "name": "linux-clang-debug",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "linux-clang-release",
      "inherits": "linux-clang-debug",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}
    },
    {
      "name": "linux-clang-address",
      "inherits": "linux-clang-debug",
      "cacheVariables": {
        "YUUMI_BUILD_EXAMPLES": "OFF",
        "YUUMI_SANITIZER": "address"
      }
    },
    {
      "name": "linux-clang-thread",
      "inherits": "linux-clang-debug",
      "cacheVariables": {
        "YUUMI_BUILD_EXAMPLES": "OFF",
        "YUUMI_SANITIZER": "thread"
      }
    },
    {
      "name": "macos-clang-debug",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "macos-clang-release",
      "inherits": "macos-clang-debug",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}
    }
  ],
  "buildPresets": [
    {"name": "windows-msvc-debug-build", "configurePreset": "windows-msvc-debug", "configuration": "Debug"},
    {"name": "windows-msvc-release-build", "configurePreset": "windows-msvc-release", "configuration": "Release"},
    {"name": "linux-clang-debug-build", "configurePreset": "linux-clang-debug"},
    {"name": "linux-clang-release-build", "configurePreset": "linux-clang-release"},
    {"name": "linux-clang-address-build", "configurePreset": "linux-clang-address"},
    {"name": "linux-clang-thread-build", "configurePreset": "linux-clang-thread"},
    {"name": "macos-clang-debug-build", "configurePreset": "macos-clang-debug"},
    {"name": "macos-clang-release-build", "configurePreset": "macos-clang-release"}
  ],
  "testPresets": [
    {"name": "windows-msvc-debug-test", "configurePreset": "windows-msvc-debug", "configuration": "Debug"},
    {"name": "windows-msvc-release-test", "configurePreset": "windows-msvc-release", "configuration": "Release"},
    {"name": "linux-clang-debug-test", "configurePreset": "linux-clang-debug"},
    {"name": "linux-clang-release-test", "configurePreset": "linux-clang-release"},
    {"name": "linux-clang-address-test", "configurePreset": "linux-clang-address"},
    {"name": "linux-clang-thread-test", "configurePreset": "linux-clang-thread"},
    {"name": "macos-clang-debug-test", "configurePreset": "macos-clang-debug"},
    {"name": "macos-clang-release-test", "configurePreset": "macos-clang-release"}
  ]
}
